# Copy this file to `.env` in the same directory. Docker Compose reads it on
# its own; nothing else does, and it is the one place a secret lives — never in
# compose.yaml, which people share and commit.
#
# The voice relay's shared secret. Linger's server signs short-lived relay
# passwords with it and coturn checks them with it, so both containers need
# the same value. Generate one: `openssl rand -hex 32`. Leave the whole file
# out for a server with no relay.
LINGER_TURN_SECRET=

# Start the relay with every `docker compose up -d`, so no command needs
# `--profile voice`. update.sh works it out either way.
COMPOSE_PROFILES=voice
