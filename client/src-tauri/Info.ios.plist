<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The iPhone app's additions to its Info.plist (SPEC §4.15). `tauri ios build`
  merges this file over gen/apple's own, so it outlasts regenerating the Xcode
  project. The words under each permission are what the iPhone shows when it
  asks.
-->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Linger uses the microphone only when you record a voice message or join a voice room.</string>
	<!--
	  In voice with the phone locked or another app in front (#851, SPEC
	  §4.15). Voice runs in the web view's WebRTC (pageVoice.ts), and WebKit
	  mutes a hidden page's microphone unless the app declares audio here;
	  with it, WebKit keeps the page running while it uses the microphone,
	  and iOS shows its own recording indicator. Only audio: voip is for
	  being woken by an incoming call, which needs push, and Linger has none.
	  scripts/ios-plist.test.mjs checks it.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Linger uses the camera only when you take a photo or video to share.</string>
	<!--
	  An iPhone asks before an app reaches a device on the same network
	  (Apple's TN3179, #779), and a server run at home is one. Linger's own
	  connections count: the gateway's, and a download for the share sheet
	  (phone_save.rs). The web view's don't.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Linger uses your local network only to reach a Linger server you've added on it, such as one at home.</string>
	<!--
	  Only standard, exempt encryption: HTTPS to the server, and the voice
	  encryption WebRTC has built in. Saying so here means App Store Connect
	  doesn't ask about export compliance on every upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  UIKit's scene life cycle (#838). From April 2027 Apple takes only builds
	  made with the iOS 27 SDK, and such a build that doesn't declare scenes
	  here won't launch (Apple's TN3187). iOS checks this file, not what the
	  app does at run time, so it's declared even though tao 0.37 hands iOS
	  its own configuration anyway. One window, so one scene; tao's delegate
	  (TaoSceneDelegate) runs it. The configuration is named outright: an
	  empty one is reported to crash at launch on the iOS 27 SDK
	  (tauri-apps/tauri#15719). scripts/ios-plist.test.mjs checks it's here.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!--
	  "Open in Linger" (#607): the linger:// scheme that tauri.conf.json's
	  deep-link plugin opens. The plugin writes this into gen/apple's
	  Info.plist itself, but only when its build script runs, which a cached
	  build skips: the simulator check's build came out without it, and iOS
	  refused the link (#835). This file is merged into every build.
	  scripts/ios-plist.test.mjs checks the two agree.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>linger</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>linger</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
