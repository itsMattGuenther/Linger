{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linger",
  "version": "0.3.3",
  "identifier": "com.linger.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Linger",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' ipc: http://ipc.localhost https: wss:; font-src 'self'; base-uri 'self'; form-action 'none'; frame-src 'none'; worker-src 'self'; manifest-src 'none'; frame-ancestors 'none'; object-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:*; media-src 'self' blob: https: http://localhost:* http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; font-src 'self'; base-uri 'self'; form-action 'none'; frame-src 'none'; worker-src 'self'; manifest-src 'none'; frame-ancestors 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/itsMattGuenther/Linger/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDRDRCMjU5MkVDMUZERjgKUldUNC9jRXVXYkxVakczU0wxWXdqZGd4eWdPUkhuOXpDaWN2L2s5a3pybm4veUU2S1ZTNkQ4bVQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-pulseaudio"
        ]
      },
      "rpm": {
        "depends": [
          "/usr/lib64/gstreamer-1.0/libgstapp.so",
          "/usr/lib64/gstreamer-1.0/libgstaudioconvert.so",
          "/usr/lib64/gstreamer-1.0/libgstaudioresample.so",
          "/usr/lib64/gstreamer-1.0/libgstcoreelements.so",
          "/usr/lib64/gstreamer-1.0/libgstinterleave.so",
          "/usr/lib64/gstreamer-1.0/libgstautodetect.so",
          "/usr/lib64/gstreamer-1.0/libgstpulseaudio.so"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "template": "windows/main.wxs",
        "upgradeCode": "465ad9d4-963e-58d4-ac8c-2730a192a3e0"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
