<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The iPhone app's privacy manifest (#779). Apple asks an app to say whether
  it tracks anybody, and why its own code makes certain system calls, the
  "required reason" APIs. Linger tracks nobody (AGENTS.md hard rule 4).
  Rust's file functions read a file's size and dates (`stat`, `fstat`), and
  Linger only uses them on its own folders: the downloads it hands the share
  sheet live in the app's temporary folder (phone_save.rs). ios.yml prints
  which of Apple's listed calls the built app makes, so a new one shows up
  there to be declared here.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- Files inside the app's own container. -->
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
