<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The notification extension's one entitlement (#889): the App Group it
  shares with the app. The app keeps each server's notification keys in a
  Keychain entry in the group's access group (src-tauri/src/phone_push/ios.rs),
  which this reads. The same group is in linger-client_iOS.entitlements and
  ShareExtension.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.itsmattguenther.linger</string>
	</array>
</dict>
</plist>
