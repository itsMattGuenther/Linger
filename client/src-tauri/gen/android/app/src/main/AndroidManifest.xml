<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the web view see the network come and go (navigator.onLine and
         its events), so the app reconnects the moment there's a network
         again (core/phone.ts, watchNetwork). No prompt: a normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- A chime with the phone on vibrate buzzes instead (lib/sound.ts,
         src-tauri/src/ringer.rs). No prompt: a normal permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice messages (#401) and voice rooms (#429): the web view records
         with the page's own microphone (app/chat/recorders.ts,
         lib/pageVoice.ts). Android asks the person the first time they press
         Record or Join, and never before. The web view's own client asks for
         both when a page asks for a microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The call bar (#429, VoiceCallService): while in voice, a foreground
         service keeps the call going with the phone locked, which Android
         allows only with its one notification showing. Android 13 and later
         ask before it may show (POST_NOTIFICATIONS); it is the only
         notification Linger ever shows (SPEC §4.15). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- No cloud backup (SPEC §4.15): what the app keeps doesn't go to Google,
         and there's no setting to put it back in (dropped 2026-10-03). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.linger_client"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- "Open in Linger" on an invite page (#607): a linger:// link
                 opens the app, which only fills its paste box
                 (src-tauri/src/deep_link.rs). The deep-link plugin writes
                 the block below from tauri.conf.json's
                 plugins.deep-link.mobile on every build. -->
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="linger" />
                
                
                
                
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <!-- Share to Linger (#785, SPEC §4.15): pictures, videos, sound and
                 other files from another app's share sheet. MainActivity hands
                 them to SharedInbox, which copies them where the shell reads
                 them (src-tauri/src/shared.rs), and the page asks which
                 conversation they're for. No text/*: a link or words shared
                 from a browser is text, and Linger takes only files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- The call bar (#429): runs only while in voice, and goes when
             the app is swiped away, since the call lived in its page. -->
        <service
            android:name=".VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="true" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
