<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the web view see the network come and go (navigator.onLine and
         its events), so the app reconnects the moment there's a network
         again (core/phone.ts, watchNetwork). No prompt: a normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- A chime with the phone on vibrate buzzes instead (lib/sound.ts,
         src-tauri/src/ringer.rs). No prompt: a normal permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice messages (#401) and voice rooms (#429): the web view records
         with the page's own microphone (app/chat/recorders.ts,
         lib/pageVoice.ts). Android asks the person the first time they press
         Record or Join, and never before. The web view's own client asks for
         both when a page asks for a microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The call bar (#429, VoiceCallService): while in voice, a foreground
         service keeps the call going with the phone locked, which Android
         allows only with its one notification showing. Android 13 and later
         ask before it may show (POST_NOTIFICATIONS), and before phone
         notifications may (#830, LingerMessagingService), asked once, when
         somebody turns those on (SPEC §4.15). -->
    <!-- A server on the phone's own network, such as one at home (#842):
         Android 17 blocks reaching it until the person allows it, under
         "Nearby devices". Asked only when a server's address is on the
         Wi-Fi or Ethernet the phone is on (src-tauri/src/phone_network.rs,
         LocalNetwork); a server on the internet never asks. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- No cloud backup (SPEC §4.15): what the app keeps doesn't go to Google,
         and there's no setting to put it back in (dropped 2026-10-03). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.linger_client"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <!-- The phone's launcher opens it through an entry below, one
                 per look of the icon (#961); this stays for Android TV. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- "Open in Linger" on an invite page (#607): a linger:// link
                 opens the app, which only fills its paste box
                 (src-tauri/src/deep_link.rs). The deep-link plugin writes
                 the block below from tauri.conf.json's
                 plugins.deep-link.mobile on every build. -->
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="linger" />
                
                
                
                
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <!-- Share to Linger (#785, SPEC §4.15): pictures, videos, sound and
                 other files from another app's share sheet. MainActivity hands
                 them to SharedInbox, which copies them where the shell reads
                 them (src-tauri/src/shared.rs), and the page asks which
                 conversation they're for. No text/*: a link or words shared
                 from a browser is text, and Linger takes only files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- The home screen icon (#961, SPEC §4.15): a launcher entry per look,
             in the order of scripts/app-icon-looks.mjs, and one on. Only the
             door's first is on here: Android ends the app when an entry on
             here is turned off, so that happens once, and the door comes
             back through its second entry, last (AppIcon.kt).
             scripts/app-icons.mjs makes the icons. -->
        <activity-alias
            android:name=".IconDoor"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/main_activity_title"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAfterDark"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_after_dark"
            android:label="@string/main_activity_title"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPorchLight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_porch_light"
            android:label="@string/main_activity_title"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDaylight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_daylight"
            android:label="@string/main_activity_title"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDusk"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_dusk"
            android:label="@string/main_activity_title"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOriginal"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_original"
            android:label="@string/main_activity_title"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconDoorAgain"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/main_activity_title"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The call bar (#429): runs only while in voice, and goes when
             the app is swiped away, since the call lived in its page. -->
        <service
            android:name=".VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="true" />

        <!-- Phone notifications (#830, SPEC §4.15): Google hands this what
             the relay passed on, encrypted to this phone, and it opens and
             shows it. Nothing outside Linger can start it. -->
        <service
            android:name=".LingerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Firebase carries notifications and does nothing else (hard rule
             4): it doesn't start itself before somebody turns notifications
             on, collects nothing, measures no deliveries, and has no
             analytics to switch on. client/src/next/privacy.test.ts checks
             each of these stays. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="delivery_metrics_exported_to_big_query_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
