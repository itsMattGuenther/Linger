# Rust
/target/
client/src-tauri/target/
**/*.rs.bk

# Node / frontend
node_modules/
client/dist/
*.tsbuildinfo

# Tauri generated schemas
client/src-tauri/gen/schemas/
# Written by tauri-build from build.rs's command list on every build
client/src-tauri/permissions/autogenerated/

# Local data: a server's entire state lives here — never commit it.
# `/data/` is where the server writes when you run it from the repo root;
# `client/data/` is where it lands if you run it from `client/`, and that
# directory holds the JWT signing key.
/data/
/client/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Secrets and local config
.env
.env.*
*.key
*.pem
# Tauri updater signing key — backed up OFFLINE, never in git (ARCHITECTURE §7)
*.key.pub

# Editors and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build/test droppings
/dist/
coverage/
client/test-results/
client/playwright-report/
